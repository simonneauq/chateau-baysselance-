# Copier ce fichier vers .env.local (jamais commité) et renseigner les valeurs réelles.

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire de contact (obligatoire dès que
# RESEND_API_KEY est renseignée — volontairement absente du code).
CONTACT_TO_EMAIL=

# Adresse expéditrice. "onboarding@resend.dev" (valeur par défaut) fonctionne
# sans domaine vérifié, mais Resend n'autorise alors l'envoi qu'à l'adresse
# email du compte Resend lui-même. Pour envoyer à n'importe quelle adresse
# (dont CONTACT_TO_EMAIL si ce n'est pas l'adresse du compte),
# il faut vérifier un domaine dans Resend et utiliser une adresse de ce domaine.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# URL publique du site, utilisée pour le sitemap et les métadonnées SEO
NEXT_PUBLIC_SITE_URL=https://chateaubaysselance.fr
